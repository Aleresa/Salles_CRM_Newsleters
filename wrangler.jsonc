{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "salles-crm-newsleters",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-22",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/telegram/webhook"] },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "NewsletterStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NewsletterStore"] }],
  "vars": {
    "BOT_USERNAME": "Salles_CRM_Newsleters_Bot",
    "MINI_APP_URL": "https://t.me/Salles_CRM_Newsleters_Bot/myapp"
  }
}
